# Copy to .env and fill in.
OPENAI_API_KEY=sk-...
# Model used by all agents (any OpenAI chat model with JSON-schema support).
# The default in code is gpt-4o-mini. Any model you use must be listed in
# MODEL_PRICING in backend/echolens/config.py, otherwise a frontier-tier fallback
# price is assumed for cost budgets.
ECHOLENS_MODEL=gpt-4o-mini
# SQLite for dev; swap for a Postgres URL later (e.g. Supabase pooler)
ECHOLENS_DB_URL=sqlite:///echolens.db

# Deployment mode: dev (auth OFF, anonymous admin) | staging | production (auth required).
# Set this EXPLICITLY on every deployed environment; never leave it to the default.
ECHOLENS_ENV=dev

# ── v1.0 collectors (all optional) ──────────────────────────────────────
# Play Store needs no credentials. GitHub is optional (raises rate limits).
# Reddit was removed as a live source: Reddit ended free API access in 2026.
GITHUB_TOKEN=
COLLECTOR_INTERVAL_HOURS=6

# ── v1.0 auth ───────────────────────────────────────────────────────────
# Signing key for access tokens. Must be a strong random value outside dev, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod
# Signing algorithm (leave as HS256 unless you know you need another).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# CORS: your frontend origin(s), comma-separated (required in production)
CORS_ORIGINS=

# ── public demo: browse without an account ──────────────────────────────
# true = a visitor with no token is admitted as a read-only VIEWER. They can
# see every screen but cannot start investigations (which spend OpenAI
# credits), connect sources, or delete anything.
#
# This is NOT the same as ECHOLENS_ENV=dev, which admits anonymous callers as a
# full ADMIN. For a link you share, use ECHOLENS_ENV=production + ALLOW_GUEST.
ALLOW_GUEST=false

# Guests see ONLY products flagged as demo (Product.is_demo). Without this a
# public URL lists every real product in the workspace — their reviews,
# findings and costs. Leave true unless the deployment is private.
GUEST_DEMO_ONLY=true

# ── Google sign-in (optional) ───────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials → OAuth client ID →
# Web application. Add your frontend origin under "Authorised JavaScript
# origins". Only the client ID is needed (it is public by design); no secret.
# Blank = no Google button is shown at all.
GOOGLE_CLIENT_ID=
# Role a Google account gets when it is not on the admin list. Default `viewer`
# keeps new sign-ins read-only; grant reviewer/admin deliberately.
GOOGLE_DEFAULT_ROLE=viewer
# Comma-separated email DOMAINS allowed to sign in with Google, e.g. example.com.
# Empty = only emails in GOOGLE_ADMIN_EMAILS or users that already exist.
GOOGLE_ALLOWED_DOMAINS=
# Comma-separated emails that get admin. Put your own address here.
GOOGLE_ADMIN_EMAILS=

# Free-tier bootstrap (no shell needed): if the DB has no users on startup and
# these are set, the backend creates the first admin automatically.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Seed the synthetic Lumo demo data on first boot if the corpus is empty.
SEED_ON_START=false

# ── v1.0 semantic search ────────────────────────────────────────────────
# hash (zero-dep, default) | sentence-transformers (pip install '.[embeddings]')
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=256

# Extra complaint themes to watch, comma-separated (added to the built-in list).
DETECTOR_EXTRA_TERMS=

# ── v4.0 delivery & actionability ───────────────────────────────────────
# Public URL of the frontend, used for deep links in Slack/email/tickets.
APP_BASE_URL=
ALERTS_ENABLED=true
# Findings at or above this severity (0..1) ping instantly; below → daily digest.
ALERT_INSTANT_MIN_SEVERITY=0.5
# Slack incoming-webhook URL for finding alerts + digest (optional).
SLACK_WEBHOOK_URL=
# Shared secret that guards the reply-to-act endpoint (Slack "approve"/"challenge").
SLACK_ACTION_TOKEN=
# Preferred: the Slack app's Signing Secret. When set, button clicks are verified by
# Slack's request signature instead of the deprecated token above.
SLACK_SIGNING_SECRET=
# On a Slack approve, also open a GitHub issue automatically.
AUTO_CREATE_ISSUE_ON_APPROVE=false
# Repo (owner/name) for issue creation when a product has no connected GitHub source.
GITHUB_DEFAULT_REPO=
# Secret to verify GitHub issue-webhook signatures (v6.0 fix verification). Set the
# same value in the repo's webhook config → EchoLens starts a fix-watch on close.
GITHUB_WEBHOOK_SECRET=
# Email delivery (optional; leave SMTP_HOST empty to skip email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Issue trackers beyond GitHub (optional) ─────────────────────────────
# A finding can be filed to GitHub (GITHUB_TOKEN above), Linear or Jira Cloud.
# A tracker shows up in the app only once every one of its settings is filled.
# Linear: Settings → API → Personal API keys; team id from the team's settings.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
# e.g. https://your-site.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# ── MCP server (`echolens mcp`, runs on a developer machine) ────────────
# The deployed API to query, and a bearer token for it (from /auth/login).
# e.g. https://your-echolens-api.example.com
ECHOLENS_API_URL=
ECHOLENS_API_TOKEN=

# Logging
ECHOLENS_LOG_JSON=1
ECHOLENS_LOG_LEVEL=INFO
